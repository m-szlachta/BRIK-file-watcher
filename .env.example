# Copy to .env next to compose.yaml and adjust. Compose reads it automatically.

# Image of the dispatcher itself (used by `just build/push` and compose).
DISPATCHER_REGISTRY=msiniarskiitwl
DISPATCHER_TAG=latest
DISPATCHER_IMAGE=msiniarskiitwl/brik2-dp-dispatcher:latest

# Host side
# NFS mount on the SLES host, mounted read-only into the container
BRIK_INCOMING_DIR=/mnt/brik/incoming
DISPATCHER_KUBECONFIG_FILE=./secrets/kubeconfig
# must be able to read BRIK_INCOMING_DIR and the kubeconfig file
DISPATCHER_UID=10001
DISPATCHER_GID=10001

# Kubernetes / PCAI
BRIK_DISPATCH_NAMESPACE=brik
BRIK_DISPATCH_KUBE_CONTEXT=

# Processing Job
BRIK_DISPATCH_JOB_IMAGE=registry.example.local/brik/brik-data-processing:1.0.0
BRIK_DISPATCH_JOB_IMAGE_PULL_SECRET=
BRIK_DISPATCH_JOB_SERVICE_ACCOUNT=
# JSON list; {input_path} is replaced by the file path inside the Job. BRIK_INPUT_PATH is always set as well.
BRIK_DISPATCH_JOB_ARGS=["--input", "{input_path}"]
BRIK_DISPATCH_JOB_ENV={"RESULTS_DIR": "/mnt/brik/results"}
BRIK_DISPATCH_JOB_CPU_REQUEST=2
BRIK_DISPATCH_JOB_MEMORY_REQUEST=8Gi
BRIK_DISPATCH_JOB_MEMORY_LIMIT=16Gi
BRIK_DISPATCH_JOB_GPU_RESOURCE=nvidia.com/gpu
BRIK_DISPATCH_JOB_GPU_COUNT=1
# Input volume in the Job pod: either NFS server + export ...
BRIK_DISPATCH_JOB_NFS_SERVER=nfs.example.local
BRIK_DISPATCH_JOB_NFS_PATH=/export/brik/incoming
# ... or an existing PVC (required if the namespace enforces the "restricted" Pod Security profile)
BRIK_DISPATCH_JOB_PVC_NAME=
BRIK_DISPATCH_JOB_MOUNT_PATH=/mnt/brik/incoming
BRIK_DISPATCH_JOB_ACTIVE_DEADLINE_SECONDS=21600
BRIK_DISPATCH_JOB_TTL_SECONDS_AFTER_FINISHED=3600

# Dispatcher behaviour
BRIK_DISPATCH_POLL_INTERVAL=30
BRIK_DISPATCH_STABLE_SCANS=2
BRIK_DISPATCH_MAX_CONCURRENT_JOBS=2
BRIK_DISPATCH_MAX_ATTEMPTS=3
BRIK_DISPATCH_LOG_LEVEL=INFO
BRIK_DISPATCH_LOG_FORMAT=json
